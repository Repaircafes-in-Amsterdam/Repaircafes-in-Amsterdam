# Add these to .env.local (gitignored) in the repo root and fill in.
# Find these in Thunderbird: Account Settings > Outgoing Server (SMTP).
SMTP_HOST=smtp.example.nl
SMTP_PORT=587
SMTP_USER=info@example.nl
SMTP_PASSWORD=
MAIL_FROM="Repair Cafés Amsterdam <info@example.nl>"
REPLY_TO=info@example.nl
# Optional: our own address, gets one copy of the mailing (not with --only).
MAIL_ARCHIVE=
